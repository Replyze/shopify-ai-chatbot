{
  "name": "shopify-ai-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Shopify AI chatbot integration with storefront chat widget, product FAQs, customer support and optional Replyze live chat.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app/server.ts",
    "dev": "node --env-file-if-exists=.env --watch app/server.ts",
    "demo": "node --env-file-if-exists=.env demo/server.ts",
    "sync:knowledge": "node --env-file-if-exists=.env scripts/sync-knowledge.ts",
    "check:extension": "node scripts/check-extension.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@shopify/theme-check-node": "^4.0.2",
    "@types/node": "^22.20.5",
    "liquidjs": "^10.30.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

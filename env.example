# Copy to .env (cp env.example .env) and fill in what you use. Every feature
# is optional; the service says at start which routes are on and what each
# one still needs. Never commit .env.

# --- Service ---
PORT=3000
# This service's public https address (setup page, Live data and app proxy URLs).
# `shopify app dev` sets APP_URL to its tunnel instead.
PUBLIC_URL=https://replyze-chat.example.com
# true behind a reverse proxy, so rate limits see the visitor's address (X-Forwarded-For).
TRUST_PROXY=false
# true: product answers come from demo/data/store.json instead of a store.
DEMO_MODE=false

# --- Shopify ---
# The store's myshopify.com domain. Products, prices, pages and policies are
# read from its Storefront API without a token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Optional: a Storefront API public access token (Headless channel) for higher limits.
SHOPIFY_STOREFRONT_TOKEN=
# Your app's credentials from the Dev Dashboard (`shopify app dev` sets them as
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET). The secret verifies webhooks and the app proxy.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Replyze ---
# Live product answers: the key Replyze's Live data source sends as
# "Authorization: Bearer <key>". At least 32 characters:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
LOOKUP_API_KEY=
# Signed-in customers: Settings → Chat Widget → Identity in Replyze.
REPLYZE_IDENTITY_SECRET=
# Knowledge sync (npm run sync:knowledge): an API key with knowledge:write,
# from Settings → Integrations → Developer.
REPLYZE_API_KEY=
REPLYZE_API_URL=https://client.replyze.chat/api/v1

# --- Demo (npm run demo) ---
# Empty: scripted demo answers. A wgt_... token: your real Replyze workspace.
REPLYZE_WIDGET_TOKEN=
DEMO_PORT=4300
